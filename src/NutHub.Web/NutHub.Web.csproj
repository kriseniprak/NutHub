<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>NutHub.Web</RootNamespace>
    <!-- The panel's static files are compiled into the assembly, so a release is a single executable. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NutHub.Core\NutHub.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <!-- Lists the serial ports for the driver forms. -->
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NutHub.Web.Tests" />
  </ItemGroup>
</Project>
