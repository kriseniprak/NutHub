# udev rules for NutHub: give the "nuthub" group access to USB UPSes, so the service does not need to run as
# root. Both nodes of each UPS are covered: the hidraw node, which carries the reports, and the USB device node,
# which carries the string descriptors and the reset NutHub falls back to when a UPS stops answering. Vendors that
# only make power equipment match on the vendor id; vendors that also make other USB devices match on the product
# ids NUT knows (drivers/*-hid.c and nutdrv_qx.c of Network UPS Tools).
#
# Installed in /etc/udev/rules.d/ by install.sh and "nuthub service install"; applied to connected devices with
#   udevadm control --reload-rules && udevadm trigger --subsystem-match=hidraw

ACTION=="remove", GOTO="nuthub_ups_end"
SUBSYSTEM=="hidraw", GOTO="nuthub_ups_match"
SUBSYSTEM!="usb", GOTO="nuthub_ups_end"
ENV{DEVTYPE}!="usb_device", GOTO="nuthub_ups_end"
LABEL="nuthub_ups_match"

# APC
ATTRS{idVendor}=="051d", MODE="0660", GROUP="nuthub"
# Eaton / MGE
ATTRS{idVendor}=="0463", MODE="0660", GROUP="nuthub"
# Powerware
ATTRS{idVendor}=="0592", MODE="0660", GROUP="nuthub"
# CyberPower
ATTRS{idVendor}=="0764", MODE="0660", GROUP="nuthub"
# Tripp Lite
ATTRS{idVendor}=="09ae", MODE="0660", GROUP="nuthub"
# Liebert / Vertiv
ATTRS{idVendor}=="10af", MODE="0660", GROUP="nuthub"
# Powercom
ATTRS{idVendor}=="0d9f", MODE="0660", GROUP="nuthub"
# Delta
ATTRS{idVendor}=="05dd", MODE="0660", GROUP="nuthub"
# Salicru
ATTRS{idVendor}=="2e66", MODE="0660", GROUP="nuthub"
# Ever
ATTRS{idVendor}=="2e51", MODE="0660", GROUP="nuthub"
# Phoenixtec / Liebert OEM
ATTRS{idVendor}=="06da", MODE="0660", GROUP="nuthub"
# KSTAR
ATTRS{idVendor}=="09d6", MODE="0660", GROUP="nuthub"
# iDowell
ATTRS{idVendor}=="075d", MODE="0660", GROUP="nuthub"
# Legrand
